#!/usr/bin/env bash
set -euo pipefail

start_unix="${1:?start unix timestamp is required}"
end_unix="${2:?end unix timestamp is required}"

curl -fsS \
  -H 'Content-Type: application/json' \
  -d "{\"startUnix\":${start_unix},\"endUnix\":${end_unix}}" \
  http://127.0.0.1:9010/records/slice/webcam \
  -o webcam

curl -fsS \
  -H 'Content-Type: application/json' \
  -d "{\"startUnix\":${start_unix},\"endUnix\":${end_unix}}" \
  http://127.0.0.1:9010/records/slice/screen \
  -o screen
