# Reaction rendering
REACTION_RENDER_MAX_RETRIES="5"
#
# --- Reaction timing ---------------------------------------------------------
# The timing values below are now overridable from the admin settings page
# (Settings -> REACTION TIMING), which stores them in the `reactionTiming`
# system config. Resolution order per field is: setting -> env -> built-in
# default, so these stay the deployment-wide baseline and an operator can retime
# a contest without a redeploy. Blank a field in the UI to fall back here.
# The blink/rank-count/dot animation timings are settings-only; they have no env
# equivalent and use their built-in defaults unless set in the UI.
#
# Feed window: BEFORE seconds ahead of the submission, through the judging gap,
# then AFTER seconds past the verdict. The clip spans submittedAt-BEFORE ->
# judgedAt+AFTER.
REACTION_BEFORE_SECONDS="10"
REACTION_AFTER_SECONDS="15"
# Wait at least this long past the ESTIMATED VERDICT REVEAL
#   judgedAt + Problem.assumedRuntimeSeconds + REACTION_REVEAL_DELAY_SECONDS
# before enqueuing a render, so the post-reveal feed (AFTER seconds) has actually
# been recorded. Measured from the reveal, not from judgedAt, because judgedAt is
# only when judging started.
# Must be >= REACTION_AFTER_SECONDS; the extra margin absorbs recording lag.
REACTION_RENDER_DELAY_SECONDS="20"
# Safety buffer on the estimated judge-finish time, in seconds.
#
# A submission's judgedAt is when judging STARTED, not when it finished, so the
# verdict only surfaces to the contestant around
#   judgedAt + Problem.assumedRuntimeSeconds
# The per-problem assumed runtime is set manually in the admin panel (Contest ->
# Problems -> ASSUMED RUNTIME); this buffer is added on top to absorb the
# residual slop (clock drift, a problem running slower than assumed) so the
# pending->verdict reveal never fires before the on-screen reaction. Clamped
# down at render time when the clip is too short to fit the whole reveal.
REACTION_REVEAL_DELAY_SECONDS="1"
# Patterned brand background behind the video cards. Optional; a flat colour is
# used when unset. Scaled to cover 1080x1920.
REACTION_RENDERER_BACKGROUND="./assets/reaction/background.png"
# Brand mark: shown in the white header bar, and used as the crest for users
# with no group or no university logo on disk.
REACTION_RENDERER_LOGO="./assets/reaction/logo.png"
REACTION_RENDERER_FONT="./assets/reaction/font.ttf"
# Both optional; fall back to REACTION_RENDERER_FONT when unset.
# The mono face is used for the contest clock and verdict letters.
REACTION_RENDERER_FONT_BOLD="./assets/reaction/font-bold.ttf"
REACTION_RENDERER_FONT_MONO="./assets/reaction/font-mono.ttf"
# All optional: a missing crest falls back to REACTION_RENDERER_LOGO.
REACTION_UNIVERSITY_LOGO_DIR="./assets/reaction/universities"
REACTION_UNIVERSITY_LOGO_EXT=".png"
REACTION_UNIVERSITY_LOGO_FALLBACK=""
REACTION_TEXT_HEADER_LEFT="VNOI"
REACTION_TEXT_HEADER_RIGHT=""
REACTION_TEXT_FOOTER="Reaction"

# Reaction S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL=""
REACTION_S3_BUCKET=""
REACTION_S3_KEY_PREFIX="reactions"
REACTION_S3_PUBLIC_BASE_URL=""

# Remote control output files
REMOTE_CONTROL_AGENT_PORT="9010"
REMOTE_CONTROL_AGENT_TOKEN=""
