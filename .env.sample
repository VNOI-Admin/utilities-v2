# Database
COMMON_DB_URI="mongodb://localhost:27017/user"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="redis123"

# Service URL
USER_SERVICE_ENDPOINT="http://localhost:8001"
AUTH_SERVICE_ENDPOINT="http://localhost:8002"
INTERNAL_SERVICE_ENDPOINT="http://localhost:8003"
PRINTING_SERVICE_ENDPOINT="http://localhost:8004"
SYNC_SERVICE_ENDPOINT="http://localhost:8005"

# Livestream proxy URL
LIVESTREAM_PROXY_URL="https://localhost"
VNOI_CONTEST_URL="https://oj.vnoi.info/contest/vnoicup25_r2"

# VNOJ API Configuration
VNOJ_API_BASE_URL="https://oj.vnoi.info"
VNOJ_API_KEY=""

# JWT Secret
JWT_ACCESS_TOKEN_SECRET="<your secret key here>"
JWT_ACCESS_TOKEN_EXPIRATION_TIME="15m"
JWT_REFRESH_TOKEN_SECRET="<your secret key here>"
JWT_REFRESH_TOKEN_EXPIRATION_TIME="7d"

# Cookie Settings
SECURE_COOKIES="true"  # Set to "false" to allow cookies over HTTP (useful for local development)

# Wireguard config for core
WG_CORE_IP_ADDRESS="10.1.0.1"
WG_CORE_PUBLIC_IP=""
WG_CORE_ALLOWED_IPS="10.0.0.0/8"
WG_CORE_PRIVATE_KEY="<your private key here>"
WG_CORE_PUBLIC_KEY="<your public key here>"
WG_MTU=1000
WG_PERSISTENT_KEEPALIVE=15

# Wireguard config
WG_CONTESTANT_BASE_SUBNET="10.10.0.0"
WG_ADMIN_BASE_SUBNET="10.100.0.0"
WG_GUEST_BASE_SUBNET="10.200.0.0"

WG_LISTEN_PORT="51820"

# wg-portal client config for the internal service.
WG_PORTAL_BASE_URL="http://localhost:8888/api/v1"
WG_PORTAL_INTERFACE_ID="wg0"
WG_PORTAL_CORE_ADMIN_USER="admin@wgportal.local"
WG_PORTAL_CORE_ADMIN_API_TOKEN="<change-me>"

# Reaction rendering
REACTION_RENDER_MAX_RETRIES="5"
REACTION_BEFORE_SECONDS="5"
REACTION_AFTER_SECONDS="10"
# Patterned brand background behind the video cards. Optional; a flat colour is
# used when unset. Scaled to cover 1080x1920.
REACTION_RENDERER_BACKGROUND="./assets/reaction/background.png"
# Brand mark: shown in the white header bar, and used as the crest for users
# with no group or no university logo on disk.
REACTION_RENDERER_LOGO="./assets/reaction/logo.png"
REACTION_RENDERER_FONT="./assets/reaction/font.ttf"
# Both optional; fall back to REACTION_RENDERER_FONT when unset.
# The mono face is used for the contest clock and verdict letters.
REACTION_RENDERER_FONT_BOLD="./assets/reaction/font-bold.ttf"
REACTION_RENDERER_FONT_MONO="./assets/reaction/font-mono.ttf"
# All optional: a missing crest falls back to REACTION_RENDERER_LOGO.
REACTION_UNIVERSITY_LOGO_DIR="./assets/reaction/universities"
REACTION_UNIVERSITY_LOGO_EXT=".png"
REACTION_UNIVERSITY_LOGO_FALLBACK=""
REACTION_TEXT_HEADER_LEFT="VNOI"
REACTION_TEXT_HEADER_RIGHT=""
REACTION_TEXT_FOOTER="Reaction"

# Reaction S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL=""
REACTION_S3_BUCKET=""
REACTION_S3_KEY_PREFIX="reactions"
REACTION_S3_PUBLIC_BASE_URL=""

# Remote control output files
REMOTE_CONTROL_AGENT_PORT="9010"
REMOTE_JOB_FILES_ROOT="data/remote-job-files/"
