# Database
COMMON_DB_URI="mongodb://mongo:27017/user"

# Redis / background jobs
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Service URL
USER_SERVICE_ENDPOINT="http://localhost:8001"
AUTH_SERVICE_ENDPOINT="http://localhost:8002"
INTERNAL_SERVICE_ENDPOINT="http://localhost:8003"
PRINTING_SERVICE_ENDPOINT="http://localhost:8004"
SYNC_SERVICE_ENDPOINT="http://localhost:8005"

# Livestream proxy URL
LIVESTREAM_PROXY_URL="https://localhost"
VNOI_CONTEST_URL="https://oj.vnoi.info/contest/vnoicup25_r2"

# VNOJ API Configuration
VNOJ_API_BASE_URL="https://oj.vnoi.info"
VNOJ_API_KEY=""

# JWT Secret
JWT_ACCESS_TOKEN_SECRET="<your secret key here>"
JWT_ACCESS_TOKEN_EXPIRATION_TIME="15m"
JWT_REFRESH_TOKEN_SECRET="<your secret key here>"
JWT_REFRESH_TOKEN_EXPIRATION_TIME="7d"

# Cookie Settings
SECURE_COOKIES="true"  # Set to "false" to allow cookies over HTTP (useful for local development)

# Wireguard config for core
WG_CORE_IP_ADDRESS="10.1.0.1"
WG_CORE_PUBLIC_IP=""
# Full tunnel (0.0.0.0/0): every workstation routes ALL egress through the
# VPN core, so wg-quick policy routing - not the DHCP-installed default route -
# decides where allowlisted traffic goes. With the previous split tunnel
# (10.0.0.0/8), a contestant-run DHCP server in an online round redirected the
# workstation's public-destination firewall rules (backup server 80/443, NTP,
# ICMP) to an attacker-operated gateway; see image-builder-v2 PR
# "pin public-destination egress to the tunnel".
WG_CORE_ALLOWED_IPS="0.0.0.0/0"
WG_CORE_PRIVATE_KEY="<your private key here>"
WG_CORE_PUBLIC_KEY="<your public key here>"
WG_MTU="1000"
WG_PERSISTENT_KEEPALIVE="15"
WG_LISTEN_PORT="51820"

# Wireguard config
WG_CONTESTANT_BASE_SUBNET="10.10.0.0"
WG_ADMIN_BASE_SUBNET="10.100.0.0"
WG_GUEST_BASE_SUBNET="10.200.0.0"
# Guest machines send this as X-Guest-Token to claim a guest VPN config; empty disables the endpoint.
GUEST_VPN_TOKEN=""
# "true": contestant and guest logins, their VPN configs and every machine-facing endpoint need a request signed
# by a machine an admin approved (Machines page). Leave "false" until the new images are out and approved.
MACHINE_AUTH_REQUIRED="false"

# wg-portal server config.
WG_PORTAL_CORE_ADMIN_USER="admin@wgportal.local"
WG_PORTAL_CORE_ADMIN_PASSWORD="<change-me>"
WG_PORTAL_CORE_ADMIN_API_TOKEN="<change-me>"
WG_PORTAL_WEB_EXTERNAL_URL="http://localhost:8888"
WG_PORTAL_WEB_SESSION_SECRET="<change-me-long-random-string>"
WG_PORTAL_WEB_CSRF_SECRET="<change-me-long-random-string>"

# wg-portal client config for the internal service.
WG_PORTAL_BASE_URL="http://host.docker.internal:8888/api/v1"
WG_PORTAL_INTERFACE_ID="wg0"

# Reaction rendering
REACTION_RENDER_MAX_RETRIES="5"
REACTION_BEFORE_SECONDS="5"
REACTION_AFTER_SECONDS="10"
REACTION_RENDERER_BACKGROUND="./assets/reaction/background.png"
REACTION_RENDERER_LOGO="./assets/reaction/logo.png"
REACTION_RENDERER_FONT="./assets/reaction/font.ttf"
REACTION_UNIVERSITY_LOGO_DIR="./assets/reaction/universities"
REACTION_UNIVERSITY_LOGO_EXT=".png"
REACTION_UNIVERSITY_LOGO_FALLBACK="./assets/reaction/universities/_default.png"
REACTION_DEFAULT_UNIVERSITY_NAME="University"
REACTION_TEXT_HEADER_LEFT="VNOI"
REACTION_TEXT_HEADER_RIGHT=""
REACTION_TEXT_FOOTER="Reaction"

# Reaction S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL=""
REACTION_S3_BUCKET=""
REACTION_S3_KEY_PREFIX="reactions"
REACTION_S3_PUBLIC_BASE_URL=""

# Remote control output files
REMOTE_CONTROL_AGENT_PORT="9010"
REMOTE_JOB_FILES_ROOT="data/remote-job-files/"

# Admin Panel
VITE_APP_USER_ENDPOINT=http://localhost:8001
VITE_APP_AUTH_ENDPOINT=http://localhost:8002
VITE_APP_INTERNAL_ENDPOINT=http://localhost:8003
VITE_APP_PRINTING_ENDPOINT=http://localhost:8004

VITE_APP_APP_ENV=production

# Out-of-band firewall verification (central probes the machines; opt-in schedule).
# FIREWALL_PROBE_CRON=""
# FIREWALL_PROBE_BLOCKED_PORTS="23,111,445,631"
# FIREWALL_PROBE_TIMEOUT_MS="2000"
# FIREWALL_PROBE_HANDSHAKE_MAX_AGE_SECONDS="900"
